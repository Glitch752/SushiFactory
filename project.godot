; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sushi Factory"
run/main_scene="uid://br5jostnw8e3n"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.223222, 0.306852, 0.34479, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://eehbl3msp0i5"
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://scripts/data_loader/data_loader.gd"
TagHighlight="*res://scripts/tag_highlight.gd"
PlayerInventorySingleton="*res://scripts/player_inventory_singleton.gd"
InteractionSingleton="*res://ui/interaction_singleton.gd"
EmailSystem="*res://world/interactable/computer/emails/EmailSystem.tscn"
DayManagerSingleton="*res://scripts/DayManagerSingleton.tscn"
CustomerManagerSingleton="*res://scripts/customer_manager_singleton.gd"
StoreStatsSingleton="*res://scripts/store_stats_singleton.gd"
MusicPlayer="*res://MusicPlayer.tscn"
SoundManager="*res://ui/audio/SoundManager.tscn"
InputTargetSingleton="*res://scripts/input_target_singleton.gd"
InputSettingsSingleton="*res://scripts/input_settings_singleton.gd"
LocalizationSingleton="*res://scripts/localization_singleton.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/resource_translation/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://data/": "orange",
"res://localization/": "red",
"res://world/interactable/": "teal"
}

