recipe_information = "[item]Dragon_roll[/item]s are made with [item]shrimp_tempura[/item], [item]sliced_cucumber[/item], [item]sliced_avocado[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Dragon_roll[/item]s are a western sushi invention topped with avacado to resemble dragon scales."
