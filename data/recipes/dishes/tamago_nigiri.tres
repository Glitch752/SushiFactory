recipe_information = "[item]Tamago_nigiri[/item] is made with [item]tamago[/item] (egg omelette) from a [machine]frying_pan[/machine] and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Tamago_nigiri[/item] is a traditional Japanese dish consisting of a small mound of sushi rice topped with a slice of tamago."
