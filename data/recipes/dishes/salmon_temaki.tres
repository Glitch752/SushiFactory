recipe_information = "[item]Salmon_temaki[/item] is made with [item]sliced_salmon[/item], [item]sliced_cucumber[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Temaki is a sushi variant using a hand-rolled nori cone to contain rice and toppings."
