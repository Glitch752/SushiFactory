recipe_information = "[item]Rainbow_roll[/item]s are made with [item]sliced_salmon[/item], [item]sliced_tuna[/item], [item]imitation_crab[/item], [item]sliced_cucumber[/item], [item]sliced_avocado[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Rainbow_roll[/item]s are a popular western variation on the [item]california_roll[/item] containing mixed colorful fish and vegetables."
