msgstr ""

#. TRANSLATORS: Recipe information for recipe California Roll
#: data/recipes/dishes/california_roll.tres
msgid "[item]California_roll[/item]s are made with [item]sliced_cucumber[/item], [item]sliced_avocado[/item], [item]imitation_crab[/item], [item]nori_bundle[/item] (seaweed) and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]California_roll[/item]s are a western-style sushi containing [item]imitation_crab[/item]."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Cucumber Maki
#: data/recipes/dishes/cucumber_maki.tres
msgid "[item]Cucumber_maki[/item] is made with [item]sliced_cucumber[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Maki is a type of sushi roll made by wrapping rice and various fillings in a sheet of nori."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Deluxe Chirashi Bowl
#: data/recipes/dishes/deluxe_chirashi_bowl.tres
msgid "[item]Deluxe_chirashi_bowl[/item]s are made with [item]sliced_salmon[/item], [item]sliced_tuna[/item], [item]shrimp[/item], [item]sliced_cucumber[/item], [item]tamago[/item] from a [machine]frying_pan[/machine], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Chirashi bowls are traditional Japanese rice bowls topped with ingredients typically found in sushi; they're essentially deconstructed sushi."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Dragon Roll
#: data/recipes/dishes/dragon_roll.tres
msgid "[item]Dragon_roll[/item]s are made with [item]shrimp_tempura[/item], [item]sliced_cucumber[/item], [item]sliced_avocado[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Dragon_roll[/item]s are a western sushi invention topped with avacado to resemble dragon scales."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Rainbow Roll
#: data/recipes/dishes/rainbow_roll.tres
msgid "[item]Rainbow_roll[/item]s are made with [item]sliced_salmon[/item], [item]sliced_tuna[/item], [item]imitation_crab[/item], [item]sliced_cucumber[/item], [item]sliced_avocado[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Rainbow_roll[/item]s are a popular western variation on the [item]california_roll[/item] containing mixed colorful fish and vegetables."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Salmon Maki
#: data/recipes/dishes/salmon_maki.tres
msgid "[item]Salmon_maki[/item] is made with [item]sliced_salmon[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Maki is a type of sushi roll made by wrapping rice and various fillings in a sheet of nori."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Salmon Nigiri
#: data/recipes/dishes/salmon_nigiri.tres
msgid "[item]Salmon_nigiri[/item] is made with [item]sliced_salmon[/item] and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Nigiri is a traditional Japanese dish consisting of a small mound of sushi rice topped with a slice of raw fish."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Salmon Temaki
#: data/recipes/dishes/salmon_temaki.tres
msgid "[item]Salmon_temaki[/item] is made with [item]sliced_salmon[/item], [item]sliced_cucumber[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Temaki is a sushi variant using a hand-rolled nori cone to contain rice and toppings."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Spicy Tuna Roll
#: data/recipes/dishes/spicy_tuna_roll.tres
msgid "[item]Spicy_tuna_roll[/item]s are made with [item]sliced_tuna[/item], [item]nori_bundle[/item] (seaweed), [item]cooked_rice[/item] from a [machine]rice_cooker[/machine], and spicy sauce (use your imagination). [item]Spicy_tuna_roll[/item]s are a western type of sushi typically seasoned with sasame siracha sauce."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Tamago Nigiri
#: data/recipes/dishes/tamago_nigiri.tres
msgid "[item]Tamago_nigiri[/item] is made with [item]tamago[/item] (egg omelette) from a [machine]frying_pan[/machine] and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. [item]Tamago_nigiri[/item] is a traditional Japanese dish consisting of a small mound of sushi rice topped with a slice of tamago."
msgstr ""

#. TRANSLATORS: Recipe information for recipe Tuna Temaki
#: data/recipes/dishes/tuna_temaki.tres
msgid "[item]Tuna_temaki[/item] is made with [item]sliced_tuna[/item], [item]sliced_cucumber[/item], [item]nori_bundle[/item] (seaweed), and [item]cooked_rice[/item] from a [machine]rice_cooker[/machine]. Temaki is a sushi variant using a hand-rolled nori cone to contain rice and toppings."
msgstr ""

